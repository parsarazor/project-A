# syntax=docker/dockerfile:1

# Build stage
FROM --platform=$BUILDPLATFORM golang:1.26.11-alpine AS builder

# Install build dependencies
RUN apk add --no-cache git ca-certificates tzdata

# Set working directory
WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./

# Download dependencies
RUN go mod download

# Copy source code
COPY . .

# Build natively for the target platform (matching BuildKit's TARGETOS/TARGETARCH
# instead of hardcoding amd64, so arm64 hosts get a native image)
ARG TARGETOS
ARG TARGETARCH

# Build the application with optimizations
ARG VERSION=dev
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build \
    -trimpath -ldflags="-w -s -X main.version=${VERSION}" \
    -o /app/main ./cmd/api

# Build the migration tool (used for seeding an admin user)
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build \
    -trimpath -ldflags='-w -s' \
    -o /app/migrate ./cmd/migrate

# Build the healthcheck helper (the scratch image has no shell or wget)
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build \
    -trimpath -ldflags='-w -s' \
    -o /app/healthcheck ./cmd/healthcheck

# Production stage
FROM scratch

# Import from builder
COPY --from=builder /usr/share/zoneinfo /usr/share/zoneinfo
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --from=builder /etc/passwd /etc/passwd
COPY --from=builder /etc/group /etc/group

# Set working directory
WORKDIR /app

# Copy binaries from builder
COPY --from=builder /app/main .
COPY --from=builder /app/migrate .
COPY --from=builder /app/healthcheck .

# Expose port
EXPOSE 8080

# Set environment
ENV APP_ENV=production

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["/app/healthcheck"]

# Run as the unprivileged nobody user from /etc/passwd
USER nobody

# Run the application
ENTRYPOINT ["/app/main"]
