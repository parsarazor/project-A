# Application Settings
APP_ENV=development
APP_PORT=8080
APP_BASE_URL=http://localhost:8080

# CORS: comma-separated list of allowed origins.
# Leave unset to allow all origins in development, or to restrict to the
# API's own origin in production.
ALLOWED_ORIGINS=http://localhost:3000

# Trusted proxies: comma-separated proxy IPs/CIDRs whose X-Forwarded-For
# header is trusted when resolving the client IP (set this behind nginx,
# an ALB, etc.). Leave empty to trust nobody - the direct peer address
# is then always used.
TRUSTED_PROXIES=

# Database Settings (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=urlshortener
# Outside development, use "require" or stronger for remote databases
DB_SSLMODE=disable

# JWT Settings
# JWT_SECRET is REQUIRED in production (min 32 chars).
# Generate one with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRY=24h

# Rate Limiting (requests per minute per IP)
RATE_LIMIT_GLOBAL=300
RATE_LIMIT_AUTH=10
